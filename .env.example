# Postgres connection (compose service name is "db" in Docker)
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"

# Secret for signing session JWTs — generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public domain used in prod (Caddy auto-HTTPS)
HELPDESK_DOMAIN="helpdesk.adcommtv.com"

# Set to 1 to seed demo users on first boot; leave 0 in production
SEED_DEMO="0"
