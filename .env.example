# Postgres connection (compose service name is "db" in Docker)
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public"

# Secret for signing session JWTs — generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Public domain used in prod (Caddy auto-HTTPS)
HELPDESK_DOMAIN="helpdesk.adcommtv.com"

# Set to 1 to seed demo users on first boot; leave 0 in production
SEED_DEMO="0"

# --- Production / IP-only deploy (docker-compose.prod.yml / .ip.yml) ---
# Strong DB password:  openssl rand -base64 24
POSTGRES_PASSWORD="change-me"
# First admin created on boot (change the password after first login)
ADMIN_EMAIL="sam@adcommtv.com"
ADMIN_PASSWORD="change-me-first-login"
# Cookie Secure flag: leave unset for HTTPS; set 0 for plain http:// (IP-only)
# COOKIE_SECURE="0"
